# SmartCommerce server-side AI
OPENAI_API_KEY=
# Optional model overrides. Defaults to gpt-5-mini when omitted.
OPENAI_VISION_MODEL=
OPENAI_COMMERCE_MODEL=

# Total Tools POS provider
SMARTCOMMERCE_TOTAL_TOOLS_POS_URL=https://pos-system-ten.vercel.app
SMARTCOMMERCE_TOTAL_TOOLS_POS_API_KEY=
SMARTCOMMERCE_TOTAL_TOOLS_POS_API_KEY_HEADER=X-API-Key
SMARTCOMMERCE_TOTAL_TOOLS_POS_CURRENCY=JMD
SMARTCOMMERCE_BUSINESS_ACCOUNT_ID=
SMARTCOMMERCE_PROVIDER_ID=

# Optional browser-side provider context. Server-side defaults are used when these are omitted
# by Product Match and Ask AI; existing platform catalogue calls may still use them.
VITE_SMARTCOMMERCE_BUSINESS_ID=
VITE_SMARTCOMMERCE_PROVIDER_ID=
VITE_SMARTCOMMERCE_BRANCH_ID=
